# =====================================================================
# MediTraceX Environment Configuration Template
# Copy to .env and configure your local or cloud deployment secrets
# =====================================================================

# Application Environment: 'development' (uses SQLite fallback) or 'production' (uses MySQL)
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Project Metadata
PROJECT_NAME="MediTraceX – Intelligent Medicine Availability & Pharmacy Discovery Platform"
API_V1_STR="/api"

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Set DB_TYPE="mysql" or ENVIRONMENT="production" for MySQL deployment:
DB_TYPE=sqlite

# Option A: Full Connection String URL (Preferred for Cloud / Managed MySQL)
# Example: mysql+pymysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=

# Option B: Individual MySQL Parameters (Used if DATABASE_URL is not provided)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=meditracex_db
MYSQL_USER=
MYSQL_PASSWORD=

# ---------------------------------------------------------------------
# JWT Cryptography & Security
# ---------------------------------------------------------------------
# Generate a secure 256-bit random key for production (e.g., via `openssl rand -hex 32`)
JWT_SECRET_KEY=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 hours

# ---------------------------------------------------------------------
# CORS Allowed Origins
# ---------------------------------------------------------------------
# Use "*" for mobile app clients or comma-separated list of web origins:
CORS_ORIGINS="*"

